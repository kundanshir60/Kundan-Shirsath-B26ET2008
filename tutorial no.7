#include <iostream>
#include <cstring>
using namespace std;

class String
{
    char str[100];

public:
    String()
    {
        strcpy(str, "");
        cout << "Default constructor called" << endl;
    }

    String(char s[])
    {
        strcpy(str, s);
        cout << "Parameterized constructor called" << endl;
    }

    String(const String &s)
    {
        strcpy(str, s.str);
        cout << "Copy constructor called" << endl;
    }

    void Accept()
    {
        cout << "Enter string: ";
        cin.getline(str, 100);
    }

    void Display()
    {
        cout << "String: " << str << endl;
    }

    ~String()
    {
        cout << "Destructor called" << endl;
    }
};

int main()
{
    String s1;
    s1.Accept();
    s1.Display();

    String s2("Hello World");
    s2.Display();

    String s3(s2);
    s3.Display();

    return 0;
}
